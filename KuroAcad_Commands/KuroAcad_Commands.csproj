<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<TargetFramework>net8.0-windows</TargetFramework>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<PublishAddinFiles>true</PublishAddinFiles>
		<Configurations>Debug;Release;ACAD2018;ACAD2019;ACAD2020;ACAD2021;ACAD2022;ACAD2023;ACAD2024;ACAD2025</Configurations>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OutputType>Library</OutputType>
		<RootNamespace>KuroAcad</RootNamespace>
		<AssemblyName>KuroAcad</AssemblyName>
	</PropertyGroup>

	<!-- Default build behavior -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
		<AcadVersion>2025</AcadVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2025_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<!-- AutoCAD version selection -->
	<PropertyGroup Condition="$(Configuration.Contains('ACAD2018'))">
		<AcadVersion>2018</AcadVersion>
		<TargetFramework>net48</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2018_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('ACAD2019'))">
		<AcadVersion>2019</AcadVersion>
		<TargetFramework>net48</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2019_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('ACAD2020'))">
		<AcadVersion>2020</AcadVersion>
		<TargetFramework>net48</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2020_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('ACAD2021'))">
		<AcadVersion>2021</AcadVersion>
		<TargetFramework>net48</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2021_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('ACAD2022'))">
		<AcadVersion>2022</AcadVersion>
		<TargetFramework>net48</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2022_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('ACAD2023'))">
		<AcadVersion>2023</AcadVersion>
		<TargetFramework>net48</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2023_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('ACAD2024'))">
		<AcadVersion>2024</AcadVersion>
		<TargetFramework>net48</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2024_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('ACAD2025'))">
		<AcadVersion>2025</AcadVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2025_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<!-- Fallback if no matching configuration -->
	<PropertyGroup Condition="'$(AcadVersion)' == ''">
		<AcadVersion>2025</AcadVersion>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ObjectArxPath>C:\Autodesk\Autodesk_ObjectARX_2025_Win_64_and_32_Bit\inc</ObjectArxPath>
	</PropertyGroup>

	<!-- General optimization -->
	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="AcCoreMgd">
			<HintPath>$(ObjectArxPath)\AcCoreMgd.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="AcDbMgd">
			<HintPath>$(ObjectArxPath)\AcDbMgd.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="AcMgd">
			<HintPath>$(ObjectArxPath)\AcMgd.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
		<FrameworkReference Include="Microsoft.WindowsDesktop.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.0" />
		<PackageReference Include="PropertyChanged.Fody" Version="4.1.0" />
		<PackageReference Include="System.Management" Version="8.0.0" />
		<PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="PresentWPF\Views\Alert\alertWPF.xaml.cs">
			<DependentUpon>alertWPF.xaml</DependentUpon>
		</Compile>
		<Compile Update="PresentWPF\Views\PaletteTab\PaletteTabView.xaml.cs">
			<DependentUpon>PaletteTabView.xaml</DependentUpon>
		</Compile>
		<Compile Update="PresentWPF\Views\TemDat\TemDatView.xaml.cs">
			<DependentUpon>TemDatView.xaml</DependentUpon>
		</Compile>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>true</DesignTime>
			<AutoGen>true</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Settings1.Designer.cs">
			<DesignTimeSharedInput>true</DesignTimeSharedInput>
			<AutoGen>true</AutoGen>
			<DependentUpon>Settings1.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="Settings1.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings1.Designer.cs</LastGenOutput>
		</None>
		<None Update="start.scr">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="FodyWeavers.xml">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Autodesk.AutoCAD.ApplicationServices.Core" />
		<Using Include="Autodesk.AutoCAD.DatabaseServices" />
		<Using Include="Autodesk.AutoCAD.EditorInput" />
		<Using Include="Autodesk.AutoCAD.Geometry" />
		<Using Include="Autodesk.AutoCAD.Runtime" />
		<Using Include="System.Math" Static="True" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Resources\" />
	</ItemGroup>

</Project>
